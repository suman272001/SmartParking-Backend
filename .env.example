PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (must be a replica set for transactions to work)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-parking?retryWrites=true&w=majority

JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d

# comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
